{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "files.associations": {
    "*.css": "postcss"
  },
  "cSpell.words": [
    "FREQS",
    "GEOAPIFY",
    "Kilometres",
    "KSCSTE",
    "NATPAC",
    "sakura",
    "washi",
    "भाषा",
    "தேர்வு",
    "மொழி",
    "തിരഞ്ഞെടുക്കുക"
  ]
}
